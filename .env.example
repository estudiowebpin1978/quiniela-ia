# ─────────────────────────────────────────────────────────────
# Quiniela IA — Variables de Entorno (ejemplo para Railway/Render)
# Copia a .env.local en tu máquina local, o configura en Railway/Render Dashboard
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://quiniela-ia.httpsquiniela-ia-twovercelapp.workers.dev

# Supabase (ya configurado - reemplaza con tus valores)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
CLAVE_PUBLICABLE = your-publishable-key-here
CADENA DE CONEXION DIRECTA = postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Cron and admin protection
CRON_SECRET=your-cron-secret-here
ADMIN_EMAIL=your-email@example.com
ADMIN_EMAILS=your-email@example.com

# Transfer / Alias
TRANSFER_AUTO_APPROVE_HOURS=1

# Push notifications (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Local AI — Ollama (zero cost, no API limits)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud AI providers (fallback when Ollama unavailable)
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
HF_API_KEY=your-huggingface-api-key
HF_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cloudflare Workers AI (priority embeddings source, free 10k req/day)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CF_EMBED_MODEL=@cf/baai/bge-m3

# Groq override (optional)
GROQ_MODEL=openai/gpt-oss-120b

# AI fallback chain (ingestion & guest-facing features)
# Assistant IA: Groq -> respuesta determinista local (sin costo).
# Sorteos-similares: CF Workers AI > HuggingFace > Dice local (2-cif).
# OCR: texto local -> Tesseract.js -> Gemini (solo si hay clave).
# Sin ninguna clave el sistema responde igualmente, con fallback computo zero-cost.

# Ualá Bis integration
UALA_USERNAME=your-uala-username
UALA_CLIENT_ID=your-uala-client-id
UALA_CLIENT_SECRET=your-uala-client-secret
UALA_WEBHOOK_SECRET=