# App
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron and admin protection
CRON_SECRET=change-me
ADMIN_EMAIL=you@example.com
ADMIN_EMAILS=you@example.com

# Transfer / Alias
TRANSFER_AUTO_APPROVE_HOURS=1

# Push notifications (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Local AI — Ollama (zero cost, no API limits)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud AI providers (fallback when Ollama unavailable)
GROQ_API_KEY=
GEMINI_API_KEY=
HF_API_KEY=
HF_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cloudflare Workers AI (priority embeddings source, free 10k req/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_EMBED_MODEL=@cf/baai/bge-m3

# Groq override (optional)
GROQ_MODEL=openai/gpt-oss-120b

# AI fallback chain (ingestion & guest-facing features)
# Assistant IA: Groq -> respuesta deterministica local (sin costo).
# Sorteos-similares: CF Workers AI > HuggingFace > Dice local (2-cif).
# OCR: texto local -> Tesseract.js -> Gemini (solo si hay clave).
# Sin ninguna clave el sistema responde igualmente, con fallback computo zero-cost.


# Ualá Bis integration
UALA_USERNAME=
UALA_CLIENT_ID=
UALA_CLIENT_SECRET=
UALA_WEBHOOK_SECRET=
