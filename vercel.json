{
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron-scrape?turno=previa",
      "schedule": "15 13 * * 1-6"
    },
    {
      "path": "/api/cron-scrape?turno=primera",
      "schedule": "15 15 * * 1-6"
    },
    {
      "path": "/api/cron-scrape?turno=matutina",
      "schedule": "15 18 * * 1-6"
    },
    {
      "path": "/api/cron-scrape?turno=vespertina",
      "schedule": "15 21 * * 1-6"
    },
    {
      "path": "/api/cron-scrape?turno=nocturna",
      "schedule": "15 0 * * 0,1-6"
    },
    {
      "path": "/api/cron-feedback?turno=previa",
      "schedule": "30 13 * * 1-6"
    },
    {
      "path": "/api/cron-feedback?turno=primera",
      "schedule": "30 15 * * 1-6"
    },
    {
      "path": "/api/cron-feedback?turno=matutina",
      "schedule": "30 18 * * 1-6"
    },
    {
      "path": "/api/cron-feedback?turno=vespertina",
      "schedule": "30 21 * * 1-6"
    },
    {
      "path": "/api/cron-feedback?turno=nocturna",
      "schedule": "30 0 * * 0,1-6"
    },
    {
      "path": "/api/cron-learning",
      "schedule": "0 3 * * 0"
    }
  ]
}